# Supabase (replace with your own project credentials)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-side only (never share these)
# SUPABASE_SERVICE_ROLE=your-service-role-key-here
# JWT_SECRET=generate-a-strong-random-secret

# AI provider keys — optional fallback.
# Primary source is the `ai_providers` table (edit via Admin → AI Providers).
# These env vars are only used when the matching DB row's api_key is empty.
GROQ_API_KEY=your_groq_key_here
# GEMINI_API_KEY=your_gemini_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# JWT Secret (use a strong random string for production)
JWT_SECRET=your-jwt-secret-here

# API URL (for Vite — use /api for same-domain deployment or full URL if separate)
VITE_API_URL=/api

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (optional — for email notifications from contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ADMIN_EMAIL=your-email@gmail.com
